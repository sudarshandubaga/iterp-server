# ------------------------------------------------------------------
# Iterp API — environment template. Copy to .env and fill in values.
# ------------------------------------------------------------------

APP_NAME=iterp
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8001
APP_TIMEZONE=UTC

# ------------------------------------------------------------------
# MySQL database
# ------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=iterp
DB_USERNAME=root
DB_PASSWORD=

# ------------------------------------------------------------------
# Mail (SMTP)
# ------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@iterp.local
MAIL_FROM_NAME="Iterp"

# ------------------------------------------------------------------
# Frontend / client used to build verification & reset URLs
# ------------------------------------------------------------------
CLIENT_URL=http://localhost:5173